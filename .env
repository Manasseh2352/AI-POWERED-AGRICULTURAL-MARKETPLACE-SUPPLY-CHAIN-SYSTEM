# The app auto-detects your machine's LAN IP from the Expo dev server, so you
# normally don't need to set anything here.
#
# Only set this to override the auto-detection — e.g. a physical device on a
# different network, or a deployed backend. Must be EXPO_PUBLIC_ prefixed to be
# visible to the app. No /api prefix, no trailing slash.
#
# EXPO_PUBLIC_API_URL=http://172.20.10.3:5001
